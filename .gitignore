# Environment — NEVER commit real secrets
.env
*.env
*.env.local
*.env.*.local

# Legacy deploy-specific env (moved to root on 2026-06-25)
# deploy/litellm/.env
# deploy/litellm/*.env

# Credentials & keys
*.pem
*.key
*.crt
*.csr
*.p12
*.jks
*.pfx

# Secrets
*secret*
# Exception: Terraform resource definition files must be committed
!deploy/aws/company-existing/secrets.tf
*credential*
# prebuilt/ — binary artifacts for Phase F1 MCP servers
prebuilt/
# Exception: track pre-built artifact and build documentation for Docker reproducibility
# Git requires unignoring the directory (!prebuilt/) before file exceptions will be checked.
# Then re-ignore with prebuilt/*, and finally whitelist specific files.
!prebuilt/
prebuilt/*
!prebuilt/seqthink-server.tgz
!prebuilt/BUILD.md
*.password
*.passwd

# Build artifacts
__pycache__/
*.py[cod]
*.so
*.egg
*.egg-info/
dist/
build/
*.whl

# IDE
.idea/
.vscode/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Logs
*.log
logs/

# Local test / temp
/tmp/
*.tmp
.tmp/

# Project-specific: docs & opencode (do NOT commit context/task files)
docs/
# .opencode/ — converted to submodule (2026-07-11)
opencode.json

# Terraform generated artifacts (provider cache, state, variable files)
infra/aws/.terraform/
infra/aws/terraform-graph.dot
infra/aws/terraform-graph.svg
deploy/aws/production/.terraform/
deploy/aws/production/terraform.tfstate
deploy/aws/production/terraform.tfstate.backup
deploy/aws/production/terraform.tfvars
deploy/aws/company-existing/.terraform/
deploy/aws/company-existing/terraform.tfstate
deploy/aws/company-existing/terraform.tfstate.backup
deploy/aws/company-existing/terraform.tfvars

# Local Terraform var/state/plan artifacts — may contain secrets
deploy/aws/company-existing/envs/*.tfvars
deploy/aws/company-existing/envs/*.tfvars.backup*
deploy/aws/company-existing/terraform.tfstate.d/
deploy/aws/company-existing/plans/*.tfplan
deploy/aws/company-existing/plans/*.tfplan.txt

# Credentials directory (contains API keys and service accounts)
credentials/

# ChatGPT OAuth token persistence (auto-created by compose volume mount)
chatgpt_tokens/

# OpenCode runtime data
.omo/
