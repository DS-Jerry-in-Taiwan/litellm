# =============================================================================
# Route B-light non-sensitive runtime value population config.
# Copy to route-b-light.env (ignored by git) and customize if needed.
# =============================================================================
# DO NOT commit real secrets. Keep this file free of secret values.
# =============================================================================

AWS_PROFILE=default
AWS_REGION=ap-northeast-1

# ── RDS ───────────────────────────────────────────────────────────────────────
RDS_IDENTIFIER=litellm-postgres
RDS_USERNAME=litellm_admin
RDS_DB_NAME=litellm

# ── Secrets Manager secret names ───────────────────────────────────────────────
# These must match the secret names created by Terraform in data module.
LITELLM_MASTER_SECRET_NAME=litellm/litellm-master-key
DATABASE_URL_SECRET_NAME=litellm/database-url
REDIS_PASSWORD_SECRET_NAME=litellm/redis-password
LITELLM_SALT_SECRET_NAME=litellm/litellm-salt-key

# ── Redis auth ───────────────────────────────────────────────────────────────
# Empty string is valid for Route B-light Redis auth-disabled setup.
REDIS_PASSWORD_VALUE=
