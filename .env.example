# =============================================================================
# LiteLLM .env.example — 環境變數範本
# =============================================================================
# 用途：複製此檔為 .env 並填入真實值（.env 不可進 Git）
# 警告：LITELLM_MASTER_KEY 建議 ≥32 字元隨機字串，生產環境務必替換
#
# ⚠️ UI/DB-first 模式：provider credentials 不在此檔案設定，
#    請在 LiteLLM Admin UI 中新增：Models → LLM Credentials → Add Credential
# =============================================================================

# === LiteLLM Core Secrets（必填） ===

# 管理員金鑰 — 用於 Admin API 認證，勿給客戶端使用
# 建議：openssl rand -hex 32
LITELLM_MASTER_KEY=sk-change-me-replace-before-use

# DB 敏感欄位加密鹽 — 建議：openssl rand -hex 32
LITELLM_SALT_KEY=replace-with-random-32-byte-secret

# === PostgreSQL Database ===

DATABASE_URL=postgresql://litellm:litellm_password_change_me@postgres:5432/litellm
POSTGRES_DB=litellm
POSTGRES_USER=litellm
POSTGRES_PASSWORD=litellm_password_change_me

# === Redis（多 pod 部署建議啟用，單機 PoC 可省略） ===

REDIS_HOST=redis
REDIS_PORT=6379
# REDIS_PASSWORD=replace-with-redis-password

# === LiteLLM General Settings ===

# 啟用 DB 儲存 model 設定（允許 Admin UI 動態新增 model）
# 僅在 config.yaml 設定 general_settings.store_model_in_db: true 不足，需同時設定此 env
STORE_MODEL_IN_DB=True

# === 可選：Admin UI 基本認證 ===
# UI_USERNAME=admin
# UI_PASSWORD=replace-with-admin-ui-password

# === OpenCode Virtual Key ===
# 此為 OpenCode 端使用的 LiteLLM virtual key，非 master key。
# 產生方式：python3 scripts/litellm_model_registry.py --create-opencode-key
# 注意：此 key 不會存在 LiteLLM DB 中，僅在建立時顯示一次
# LITELLM_API_KEY=sk-litellm-vkey-...

# === 可選：SMTP（寄送用量通知等） ===
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USERNAME=your-smtp-user
# SMTP_PASSWORD=your-smtp-password

# === MCP Server API Keys（config.yaml mcp_servers 使用 os.environ/ 引用） ===
# 若使用 LiteLLM MCP Hub 功能，需設定以下環境變數：
# 所有 keys 只填入 .env，絕對不可 commit 到 Git
TAVILY_API_KEY=
SUPERMEMORY_API_KEY=
BRAVE_API_KEY=
GITHUB_PERSONAL_ACCESS_TOKEN=

# =============================================================================
# Provider Credentials（透過 Admin UI 管理，不要寫入此檔案）
# =============================================================================
# 請至 LiteLLM Admin UI 建立 LLM Credentials：
#   Models → LLM Credentials → Add Credential
#
# 热门公共模型（Google AI Studio，无需自行托管）：
#   - gemini-2.5-flash-lite   (route: gemini/gemini-2.5-flash-lite)
#   - gemini-2.5-flash        (route: gemini/gemini-2.5-flash)
#   - gemini-2.5-pro          (route: gemini/gemini-2.5-pro)
#
# 建立 credential 後，透過 Admin UI 或 /model/new API 將模型加入系統。
# =============================================================================
