# Copy this file to a local ignored file before use, for example:
#   cp scripts/litellm_model_registry.env.example .env.model_registry.tmp
#   chmod 600 .env.model_registry.tmp
#
# Never commit real values. The script never prints these secrets.

# LiteLLM Admin API key. Locally this is the same value as .env:LITELLM_MASTER_KEY.
LITELLM_MASTER_KEY=sk-replace-with-litellm-master-key

# Kimi / Moonshot CN endpoint credential for moonshotai-cn/kimi-k2.5.
MOONSHOT_API_KEY=replace-with-moonshot-api-key

# OpenCode API key shared by:
# - opencode-go/minimax-m2.7 at https://opencode.ai/zen/go/v1
# - opencode/deepseek-v4-flash-free at https://opencode.ai/zen/v1
OPENCODE_API_KEY=replace-with-opencode-api-key

# Anthropic credential for anthropic/claude-sonnet-4-6.
ANTHROPIC_API_KEY=replace-with-anthropic-api-key
