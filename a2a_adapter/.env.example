# A2A Adapter local runtime example
# Copy to a local-only file if needed. Do not commit real secrets.

OPENCODE_BASE_URL=http://127.0.0.1:4096
A2A_HOST=127.0.0.1
A2A_PORT=18001
A2A_PUBLIC_URL=http://127.0.0.1:18001
A2A_TASK_STORE_BACKEND=memory
A2A_LOG_LEVEL=INFO

# Generate a real token outside version control:
#   python3 -c 'import secrets; print(secrets.token_hex(24))'
A2A_STATIC_AUTH_CREDENTIALS='[{"scheme":"bearer","token":"replace-with-generated-token","principal":"local-dev"}]'

# Optional: for E2E test with LiteLLM (Phase 6)
# LITELLM_MASTER_KEY=sk-your-litellm-master-key
